{
  "name": "crm-generativo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CRM Generativo: extensão do Chrome (MV3) com telas geradas por IA.",
  "scripts": {
    "vendor": "esbuild tools/anthropic-entry.js --bundle --format=esm --platform=browser --minify --legal-comments=eof --outfile=extension/src/vendor/anthropic.js",
    "icons": "node tools/make-icons.mjs",
    "test": "node --test tests/unit/*.test.mjs",
    "test:e2e": "node tests/e2e/run.mjs",
    "package": "python3 tools/package.py",
    "web": "npm run -s package && node tools/build-web.mjs",
    "serve": "python3 -m http.server 8095 --bind 0.0.0.0 --directory dist/web"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "axe-core": "^4.10.3",
    "esbuild": "^0.25.10",
    "playwright-core": "^1.56.1"
  }
}
